{
	"name": "@raineworks/ha-dashboards",
	"version": "1.3.3",
	"type": "module",
	"description": "Raineworks Dashboards' house settings parser, bedtime routines and setup MCP server, for a house's own Home Assistant config repository",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/raine-works/ha-dashboards.git",
		"directory": "packages/kit"
	},
	"bin": {
		"raineworks-dashboards-mcp": "./dist/mcp.js"
	},
	"exports": {
		"./house": {
			"types": "./dist/types/kit/src/house.d.ts",
			"default": "./dist/house.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "bun scripts/build.ts",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@app/ha-client": "workspace:*",
		"@app/mcp": "workspace:*",
		"@app/ui": "workspace:*",
		"@types/bun": "catalog:",
		"typescript": "catalog:"
	}
}
