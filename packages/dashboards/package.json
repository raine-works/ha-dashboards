		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@app/ui": "workspace:*",
		"lucide-react": "catalog:",
		"preact": "catalog:"
	},
	"devDependencies": {
		"@app/ha-client": "workspace:*",
		"@app/dashboard-build": "workspace:*",
		"@types/bun": "catalog:",
		"typescript": "catalog:"
	}
}
