{
	"name": "ha-dashboards",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.5",
	"workspaces": [
		"packages/*"
	],
	"catalog": {
		"@babel/core": "7.29.7",
		"@biomejs/biome": "2.5.10",
		"@fontsource-variable/geist": "5.3.0",
		"@types/babel__core": "7.20.5",
		"@types/bun": "1.4.0",
		"@types/leaflet": "1.9.22",
		"babel-plugin-react-compiler": "1.0.0",
		"bun-plugin-tailwind": "0.1.2",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"leaflet": "1.9.4",
		"lucide-react": "1.58.0",
		"preact": "10.29.8",
		"recharts": "3.10.1",
		"sonner": "2.0.8",
		"tailwind-merge": "3.7.0",
		"tailwindcss": "4.3.3",
		"typescript": "5.8.2",
		"uqr": "0.1.3"
	},
	"devDependencies": {
		"@app/dashboard-build": "workspace:*",
		"@app/ha-client": "workspace:*",
		"@app/ui": "workspace:*",
		"@biomejs/biome": "catalog:",
		"@types/bun": "catalog:",
		"bun-plugin-tailwind": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:"
	},
	"scripts": {
		"audit:house": "bun scripts/house-audit.ts",
		"build": "bun run --filter @app/dashboards build",
		"build:integration": "bun packages/dashboards/scripts/build.ts --integration",
		"build:local": "bun run --filter @app/dashboards build:local",
		"check": "bun check",
		"demo": "bun run --filter @app/demo demo",
		"dev": "bun run --filter @app/dashboards dev",
		"format": "biome format --write .",
		"lint": "biome check . && bun scripts/tailwind-lint.ts",
		"lint:fix": "biome check --write .",
		"lint:tailwind": "bun scripts/tailwind-lint.ts",
		"mcp": "bun packages/mcp/src/index.ts",
		"report": "bun scripts/capability-report.ts",
		"test": "bun test",
		"typecheck": "bun run --filter '*' typecheck"
	}
}
